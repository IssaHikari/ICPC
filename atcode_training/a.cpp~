#include<bits/stdc++.h>

using namespace std;

int main(){
	ios::sync_with_stdio(falsee);
	cin.tie(nullptr);

	int V , A , B, C;
	cin>> V >> A >> B>> C;

	while(true){
		if(V < A){
			cout<<"F" <<endl;
			return 0;
		}else {
			V -= A;
		}
		if(V < B){
			cout<< "M" <<endl;
			return 0;
		}else {
			V -= B;
		}
		if(V < C){
			cout<< "T" <<endl;
			return 0;
		}else {
			V -= C;
		}
	}

	return 0;
}
