#include<bits/stdc++.h>

using namespace std;

int main(){
	ios::sync_with_stdio(false);
	cin.tie(nullptr);
	
	int q;
	cin>>q;
	priority_queue<int , vector<int> , greater<int>> pq;
	while(q){
		int key ,x;
		cin>>key;
		if(key == 1){
			cin>> x;
			pq.push(x);
		}else {
			int value = pq.top();
			pq.pop();
			cout<< value << endl;
		}
		q--;
	}

	return 0;
}
