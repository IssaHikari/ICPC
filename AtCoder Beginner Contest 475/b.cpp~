#include<bits/stdc++.h>

using namespace std;

int main(){
	ios::sync_with_stdio(false);
	cin.tie(0);

	long long n; cin>>n;
	long long n_100=0 ,n_10=0 ,n_1=0;
	long long m = 1000;
	for(int i =0 ;i <n ;i++){
		long long x;
		cin>> x;
		if(x > 1000){
			m = (x / 1000) * m;
			if(m % 1000 != 0) m += 1000;
		}
		int d = m - x;
		int div = d / 100;
		n_100 += div;
		int rs = d % 100;
		div = rs / 10;
		n_10 += div;
		rs = div % 10;
		n_1 = rs;
	}
	cout<< n_100 << " "<< n_10 << " " << n_1<<endl;
	return 0;
}
